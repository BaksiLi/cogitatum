{
  "name": "cogitatum",
  "version": "0.3.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:public": "npm run build -w @cogitatum/core && npm run build -w @cogitatum/cli && npm run build -w @cogitatum/view",
    "test": "vitest run",
    "check:cli": "node scripts/check-cli.mjs",
    "check:docs": "node --conditions development --import tsx scripts/check-doc-examples.mjs",
    "check:json": "node scripts/check-json.mjs",
    "check:versions": "node scripts/check-contract-versions.mjs",
    "check:packages": "npm run build:public && node scripts/check-packages.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "cog": "tsx --conditions development packages/cli/src/index.ts",
    "cog:dist": "node packages/cli/dist/index.js",
    "build": "npm run build:public",
    "check": "npm run build && npm test && npm run check:cli && npm run check:docs && npm run check:json && npm run check:versions && npm run check:packages"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "ajv": "^8.20.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^3.2.2"
  }
}
