{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogitatum.baksili.codes/schemas/0.6.0/explain.schema.json",
  "title": "Cogitatum Explain Projection",
  "description": "Recognition and compiler effects for one source unit. Emitted summaries obey canonical target restrictions; rejected candidates may retain unresolved or invalid targets. Agreement with a graph is checked separately.",
  "type": "object",
  "required": ["version", "entries", "diagnostics"],
  "properties": {
    "version": { "const": "0.6.0" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "additionalProperties": false,
  "$defs": {
    "objectNote": {
      "type": "object",
      "required": ["origin", "target", "sourceSpan"],
      "properties": {
        "origin": { "enum": ["note", "constructor-description"] },
        "target": { "oneOf": [{ "$ref": "#/$defs/pointRef" }, { "$ref": "#/$defs/bearingRef" }] },
        "sourceSpan": { "$ref": "#/$defs/sourceSpan" }
      },
      "allOf": [{
        "if": { "properties": { "origin": { "const": "constructor-description" } } },
        "then": { "properties": { "target": { "$ref": "#/$defs/bearingRef" } } }
      }],
      "additionalProperties": false
    },
    "sourceSpan": {
      "type": "object",
      "required": ["startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "authoredId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "pointKey": { "type": "string", "minLength": 1 },
    "bearingKey": { "type": "string", "minLength": 1 },
    "authoredRef": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/authoredId" } },
      "additionalProperties": false
    },
    "pointRef": {
      "type": "object",
      "required": ["key", "kind"],
      "properties": {
        "key": { "$ref": "#/$defs/pointKey" },
        "kind": { "const": "point" }
      },
      "additionalProperties": false
    },
    "bearingRef": {
      "type": "object",
      "required": ["key", "kind"],
      "properties": {
        "key": { "$ref": "#/$defs/bearingKey" },
        "kind": { "const": "bearing" }
      },
      "additionalProperties": false
    },
    "emittedBearingRef": {
      "type": "object",
      "required": ["key", "kind", "graphIndex"],
      "properties": {
        "key": { "$ref": "#/$defs/bearingKey" },
        "kind": { "const": "bearing" },
        "graphIndex": { "type": "integer", "minimum": 0 },
        "handle": { "$ref": "#/$defs/authoredId" }
      },
      "additionalProperties": false
    },
    "bearingSummary": {
      "type": "object",
      "required": ["key", "kind", "sources", "target", "derivedBy"],
      "properties": {
        "key": { "$ref": "#/$defs/bearingKey" },
        "handle": { "$ref": "#/$defs/authoredId" },
        "kind": {
          "enum": ["supports", "challenges", "concerns", "respondsTo", "clarifies", "answers"]
        },
        "sources": {
          "type": "array",
          "items": { "oneOf": [{ "$ref": "#/$defs/pointRef" }, { "$ref": "#/$defs/authoredRef" }] },
          "minItems": 1
        },
        "target": {
          "oneOf": [
            { "$ref": "#/$defs/pointRef" },
            { "$ref": "#/$defs/bearingRef" },
            { "$ref": "#/$defs/authoredRef" }
          ]
        },
        "derivedBy": { "enum": ["operator", "structural"] }
      },
      "additionalProperties": false
    },
    "emittedBearingSummary": {
      "allOf": [
        { "$ref": "#/$defs/bearingSummary" },
        {
          "type": "object",
          "properties": {
            "sources": { "type": "array", "items": { "$ref": "#/$defs/pointRef" }, "uniqueItems": true },
            "target": { "oneOf": [{ "$ref": "#/$defs/pointRef" }, { "$ref": "#/$defs/bearingRef" }] }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "enum": ["answers", "respondsTo", "clarifies"] } }, "required": ["kind"] },
              "then": { "properties": { "target": { "$ref": "#/$defs/pointRef" } } }
            }
          ]
        }
      ]
    },
    "recognition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "note" }, "targetKind": { "enum": ["point", "bearing"] } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "bearingUse" }, "ref": { "$ref": "#/$defs/authoredRef" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "use" }, "ref": { "$ref": "#/$defs/authoredRef" }, "role": { "enum": ["Q", "C", "G", "O", "R", "D"] }, "selector": { "const": "attachment" } },
          "allOf": [{ "if": { "required": ["selector"] }, "then": { "required": ["role"], "properties": { "role": { "enum": ["G", "O", "Q"] } } } }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "body" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "invalid" }, "selector": { "const": "attachment" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "role"],
          "properties": {
            "kind": { "const": "role" },
            "role": { "enum": ["Q", "C", "G", "O", "R", "D"] },
            "selector": { "const": "attachment" }
          },
          "allOf": [
            {
              "if": { "required": ["selector"] },
              "then": { "properties": { "role": { "enum": ["G", "O", "Q"] } } }
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "material" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "explicitBearing" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "localBearing" }, "role": { "enum": ["G", "O", "R", "D", "Q"] }, "selector": { "const": "attachment" } },
          "allOf": [
            {
              "if": { "required": ["selector"] },
              "then": { "required": ["role"], "properties": { "role": { "enum": ["G", "O", "Q"] } } },
              "else": { "properties": { "role": { "enum": ["G", "O", "R", "D"] } } }
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "note"],
          "properties": {
            "kind": { "const": "attachNote" },
            "note": { "$ref": "#/$defs/objectNote" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "targetKind", "crossedBodySpans"],
          "properties": {
            "kind": { "const": "selectNoteTarget" },
            "targetKind": { "enum": ["point", "bearing"] },
            "contextSpan": { "$ref": "#/$defs/sourceSpan" },
            "crossedBodySpans": { "type": "array", "items": { "$ref": "#/$defs/sourceSpan" } },
            "target": { "oneOf": [{ "$ref": "#/$defs/pointRef" }, { "$ref": "#/$defs/bearingRef" }] }
          },
          "allOf": [
            { "if": { "properties": { "targetKind": { "const": "point" } } }, "then": { "properties": { "target": { "$ref": "#/$defs/pointRef" } } } },
            { "if": { "properties": { "targetKind": { "const": "bearing" } } }, "then": { "properties": { "target": { "$ref": "#/$defs/bearingRef" } } } }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "preserveNote" }, "parentSpan": { "$ref": "#/$defs/sourceSpan" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "target", "contextSpan", "crossedBodySpans"],
          "properties": {
            "kind": { "const": "implicitAttachment" },
            "target": { "oneOf": [{ "$ref": "#/$defs/pointRef" }, { "$ref": "#/$defs/bearingRef" }] },
            "targetSpan": { "$ref": "#/$defs/sourceSpan" },
            "contextSpan": { "$ref": "#/$defs/sourceSpan" },
            "crossedBodySpans": { "type": "array", "items": { "$ref": "#/$defs/sourceSpan" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "ref", "operand"],
          "properties": { "kind": { "const": "focusBearing" }, "ref": { "$ref": "#/$defs/bearingRef" }, "operand": { "$ref": "#/$defs/authoredRef" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "contextSpan"],
          "properties": { "kind": { "const": "selectBearing" }, "contextSpan": { "$ref": "#/$defs/sourceSpan" }, "target": { "$ref": "#/$defs/bearingRef" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "ref", "operand"],
          "properties": { "kind": { "const": "focusPoint" }, "ref": { "$ref": "#/$defs/pointRef" }, "operand": { "$ref": "#/$defs/authoredRef" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reason"],
          "properties": { "kind": { "const": "rejectFocus" }, "operand": { "$ref": "#/$defs/authoredRef" }, "reason": { "enum": ["reference-error", "annotation-syntax-error"] } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "selectAttachment" }, "ownerSpan": { "$ref": "#/$defs/sourceSpan" }, "target": { "$ref": "#/$defs/bearingRef" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "localBearingSpan", "eligible", "function"],
          "properties": {
            "kind": { "const": "localBearingMember" },
            "localBearingSpan": { "$ref": "#/$defs/sourceSpan" },
            "eligible": { "type": "boolean" },
            "function": { "enum": ["source", "commentary", "independent", "supplementary", "unclassified"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "preserveBody" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "ref", "reason"],
          "properties": {
            "kind": { "const": "emitPoint" },
            "ref": { "$ref": "#/$defs/pointRef" },
            "id": { "$ref": "#/$defs/authoredId" },
            "reason": { "enum": ["role-annotation", "material-annotation"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "ref", "reason"],
          "properties": {
            "kind": { "const": "rejectPoint" },
            "ref": { "$ref": "#/$defs/pointRef" },
            "id": { "$ref": "#/$defs/authoredId" },
            "reason": { "const": "duplicate-anchor" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "ref", "bearing", "reason"],
          "properties": {
            "kind": { "const": "emitBearing" },
            "ref": { "$ref": "#/$defs/emittedBearingRef" },
            "bearing": { "$ref": "#/$defs/emittedBearingSummary" },
            "reason": { "enum": ["operator-clause", "annotated-containment", "local-bearing-containment", "local-attachment"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "rejectBearing" },
            "bearing": { "$ref": "#/$defs/bearingSummary" },
            "reason": {
              "enum": ["annotation-syntax-error", "explicit-bearing-descendant-requires-target", "bearing-use-requires-explicit-target", "failed-context-requires-explicit-target", "validation-error", "invalid-local-bearing", "no-local-attachment"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "skipBearing" },
            "reason": { "enum": ["no-eligible-ancestor", "no-structural-rule", "local-bearing-membership"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": ["sourceSpan", "recognition", "effects", "diagnosticCodes"],
      "properties": {
        "sourceSpan": { "$ref": "#/$defs/sourceSpan" },
        "recognition": { "$ref": "#/$defs/recognition" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "minItems": 1 },
        "diagnosticCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning", "suggestion"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "explanation": { "type": "string" },
        "sourceSpan": { "$ref": "#/$defs/sourceSpan" }
      },
      "additionalProperties": false
    }
  }
}
